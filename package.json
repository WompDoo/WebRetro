{
  "name": "under-construction",
  "version": "0.1.0",
  "private": true,
  "description": "Incremental game: build a website from 1997 to today.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "sim": "node build.mjs --sim-only && node dist/balance-sim.cjs",
    "players": "node build.mjs --sim-only && node dist/player-types.cjs",
    "test": "node build.mjs --tests && node --test dist/tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
